# Firebase Web SDK config (client-side, safe to expose — access is gated by
# Firestore Security Rules + the email allowlist, not by hiding these keys).
# Copy to `.env` and fill in from your Firebase project's web app settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point the app at the local Firebase Emulator Suite instead
# of a real Firebase project. The podman dev environment sets this for you.
VITE_USE_EMULATORS=false
