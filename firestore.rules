rules_version = '2';

// Wallguard Counter — shared, household-style access.
//
// There is no per-user data and no backend. Access control is THIS FILE: a
// hard-coded allowlist of emails. To add or remove a member, edit `allowlist`
// below and push to `main`; CI deploys the rules. Everyone on the list shares
// the same categories / items / checkouts.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowlist() {
      return [
        // Add member emails here (lowercase). Example:
        // 'alice@example.com',
        // 'bob@example.com',
      ];
    }

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in allowlist();
    }

    // Shared top-level collections — full access for members, nothing for
    // anyone else.
    match /categories/{id} {
      allow read, write: if isMember();
    }
    match /items/{id} {
      allow read, write: if isMember();
    }
    match /checkouts/{id} {
      allow read, write: if isMember();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
