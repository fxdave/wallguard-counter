rules_version = '2';

// Wallguard Counter — shared, household-style access.
//
// There is no backend. Access control lives here: a member is anyone whose
// (lowercased) email has a document in the `members` collection, plus the
// hardcoded OWNER below. Members manage the member list themselves from the
// Settings page (flat model — any member can add/remove others). The OWNER is
// the bootstrap superadmin: always allowed, never removable, used to seed the
// very first members when the collection is empty.
service cloud.firestore {
  match /databases/{database}/documents {

    // The bootstrap owner's Google email (lowercase). This single value seeds
    // access; everything else is managed in the UI (Settings → Members).
    function ownerEmail() {
      return 'dbiro97@gmail.com';
    }

    function emailLower() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && emailLower() == ownerEmail();
    }

    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          emailLower() == ownerEmail()
          || exists(/databases/$(database)/documents/members/$(emailLower()))
        );
    }

    // The allowlist itself. Any member may read and manage it (flat model).
    // The owner has no document and is always allowed regardless, so they can
    // never be locked out.
    match /members/{email} {
      allow read, write: if isMember();
    }

    // Shared app data — members only.
    match /categories/{id} {
      allow read, write: if isMember();
    }
    match /items/{id} {
      allow read, write: if isMember();
    }
    match /checkouts/{id} {
      allow read, write: if isMember();
    }
    match /passHolders/{id} {
      allow read, write: if isMember();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
